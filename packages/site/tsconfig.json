{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "jsx": "react-jsx",
    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": false,

    // make `tsc` throw an error if an unsupported feature is used
    // if set true all implementation files must be modules (import or export something)
    "isolatedModules": true,

    "allowJs": true,
    "forceConsistentCasingInFileNames": true,
    "plugins": [{ "name": "typescript-plugin-css-modules" }],

    // previous tsconfig.json options which were in conflict with vite default tsconfig
    // "jsx": "react",
    // "moduleResolution": "node",
    // "esModuleInterop": true,
  },

  // "include": ["src"],
  "include": ["src/**/*", "__tests__/**/*", "dist/index.d.ts"],

  "references": [
    {
      "path": "./tsconfig.node.json",
    },
  ],
}
