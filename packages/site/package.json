{
  "name": "site",
  "author": "gusalbukrk",
  "version": "0.0.0",
  "description": "",
  "license": "MIT",
  "keywords": [
    "fullfiller"
  ],
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "// comment": "vite commands has an optional positional argument which is the root; it's necessary to specify config file path if it's not inside root",
    "build": "tsc && vite build src/ -c vite.config.ts --outDir ../dist/",
    "dev": "vite src/ -c vite.config.ts",
    "lint": "cspell \"**\" -c ../../cspell.config.cjs --no-progress && eslint src/ --fix && stylelint \"src/**/*.{css,scss,sass}\" --fix",
    "preview": "vite preview",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.5.1",
    "@fortawesome/free-brands-svg-icons": "^6.5.1",
    "@fortawesome/free-regular-svg-icons": "^6.5.1",
    "@fortawesome/free-solid-svg-icons": "^7.0.1",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "core-js": "^3.35.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "styled-components": "^6.1.8",
    "fullfiller": "file:../fullfiller",
    "fullfiller-common": "file:../common",
    "idb": "8.0.0",
    "@babel/plugin-proposal-class-properties": "7.18.6"
  }
}
