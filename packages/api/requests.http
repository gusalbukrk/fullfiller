# NOTE: must insert 3 # after each request

# route parameters (`req.params`)
GET http://localhost:8888/api/harry potter/words

###
GET http://localhost:8888/api/harry potter/paragraphs/3/html/5/25/5/14

###

# query string parameters (`req.query`)
GET http://localhost:8888/api?query=harry potter&format=html&quantity=2

###

# request body (`req.body`), must include json middleware
GET http://localhost:8888/api/
Content-Type: application/json

{
    "query": "harry potter",
    "quantity": 1,
    "format": "html",
    "sentencesPerParagraph": {
      "min": 25,
      "max": 50
    }
}

###

# request body (`req.body`), must include urlencoded middleware
GET http://localhost:8888/api/
Content-Type: application/x-www-form-urlencoded

query=harry potter
&quantity=2
&format=html
