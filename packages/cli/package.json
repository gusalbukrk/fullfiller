{
  "name": "fullfiller-cli",
  "author": "gusalbukrk",
  "version": "0.0.2-alpha.0",
  "description": "Command-line interface for fullfiller.",
  "license": "MIT",
  "keywords": [
    "fullfiller",
    "cli",
    "lorem",
    "ipsum",
    "filler",
    "text",
    "dummy",
    "placeholder",
    "mockup",
    "prototyping"
  ],
  "homepage": "https://github.com/gusalbukrk/fullfiller/tree/main/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/gusalbukrk/fullfiller.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "main": "dist/bundle.cjs",
  "bin": {
    "fullfiller": "dist/bundle.js",
    "fullfiller-cli": "dist/bundle.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/bundle.js",
      "require": "./dist/bundle.cjs"
    },
    "./src": "./src/index.ts"
  },
  "files": [
    "dist",
    "src",
    "!src/**/__tests__/",
    "!src/**/__spec__/",
    "!src/**/*.test.[jt]s",
    "!src/**/*.test.[jt]sx",
    "!src/**/*.spec.[jt]s",
    "!src/**/*.spec.[jt]sx"
  ],
  "scripts": {
    "build": "rollup -c ./rollup.config.js",
    "lint": "eslint src/ --fix && cspell \"**\" -c ../../cspell.config.cjs --no-progress",
    "postbuild": "replace-in-file --configFile=./.replace-in-file.cjs",
    "postpublish": "rimraf dist/",
    "prepublishOnly": "npm run build",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@types/inquirer": "^9.0.7",
    "cacache": "^18.0.2",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "cross-fetch": "^4.0.0",
    "find-cache-dir": "^5.0.0",
    "fullfiller": "file:../fullfiller",
    "fullfiller-common": "file:../common",
    "inquirer": "^9.2.18"
  }
}
