{
  "name": "package-name",
  "author": "gusalbukrk",
  "version": "0.0.0",
  "description": "",
  "license": "MIT",
  "keywords": [
    "fullfiller"
  ],
  "homepage": "https://github.com/gusalbukrk/fullfiller/tree/main/packages/package-name#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/gusalbukrk/fullfiller.git",
    "directory": "packages/package-name"
  },
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "engines": {
    "node": ">=14.0.0"
  },
  "scripts": {
    "// comment": "vite commands has an optional positional argument which is the root; it's necessary to specify config file path if it's not inside root",
    "build": "tsc && vite build src/ -c vite.config.ts --outDir ../dist/",
    "dev": "vite src/ -c vite.config.ts",
    "lint": "cspell \"**\" -c ../../cspell.config.cjs --no-progress && eslint src/ --fix && stylelint \"src/**/*.{css,scss,sass}\" --fix",
    "preview": "vite preview",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "core-js": "^3.35.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "styled-components": "^6.1.8"
  }
}
