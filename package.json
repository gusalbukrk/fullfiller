{
  "name": "@fullfiller/monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "yarn": "use `npm` instead",
    "pnpm": "use `npm` instead"
  },
  "scripts": {
    "build": "lerna run --no-bail build",
    "clean:bootstrap": "rimraf node_modules/ packages/*/node_modules/",
    "clean:build": "rimraf packages/*/dist",
    "create": "node templates/create.js",
    "cspell": "cspell \"{**,**/.*,**/.*/**}\" -c cspell.config.cjs --no-progress",
    "lint": "npm run cspell && npm run lint:config && prettier **/*.{html,md,json} --write --loglevel warn && npm run lint:src",
    "lint:config": "eslint . --fix --ext .js,.cjs,.json --ignore-pattern '!.*' --ignore-pattern 'src/' --rule 'jest/unbound-method: off'",
    "lint:src": "lerna run --no-bail lint",
    "prepare": "husky install",
    "test": "lerna run --no-bail test"
  },
  "devDependencies": {
    "@babel/core": "^7.23.7",
    "@babel/eslint-parser": "^7.23.3",
    "@babel/preset-env": "^7.23.8",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@commitlint/cli": "^18.5.0",
    "@commitlint/config-conventional": "^18.5.0",
    "@commitlint/config-lerna-scopes": "^18.4.4",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-eslint": "^9.0.5",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@types/cacache": "^17.0.2",
    "@types/express": "^4.17.21",
    "@types/find-cache-dir": "^3.2.1",
    "@types/jest": "^29.5.11",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/react-test-renderer": "^18.0.7",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "@vitejs/plugin-react": "^4.2.1",
    "babel-plugin-styled-components": "^2.1.4",
    "core-js": "^3.35.1",
    "cross-fetch": "^4.0.0",
    "cspell": "^8.3.2",
    "eslint": "^8.56.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
