{
  "name": "@fullfiller/monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=14.0.0",
    "yarn": "use `npm` instead",
    "pnpm": "use `npm` instead"
  },
  "scripts": {
    "build": "lerna run --no-bail build",
    "clean:bootstrap": "rimraf node_modules/ packages/*/node_modules/",
    "clean:build": "rimraf packages/*/dist",
    "create": "node templates/create.js",
    "cspell": "cspell \"{**,**/.*,**/.*/**}\" -c cspell.config.cjs --no-progress",
    "lint": "npm run cspell && npm run lint:config && prettier **/*.{md,json} --write --loglevel warn && npm run lint:src",
    "lint:config": "eslint . --fix --ext .js,.cjs,.json --ignore-pattern '!.*' --ignore-pattern 'src/' --rule 'jest/unbound-method: off'",
    "lint:src": "lerna run --no-bail lint",
    "prepare": "husky install",
    "test": "lerna run --no-bail test"
  },
  "devDependencies": {
    "@babel/core": "^7.21.4",
    "@babel/eslint-parser": "^7.21.3",
    "@babel/preset-env": "^7.21.4",
    "@babel/preset-react": "^7.18.6",
    "@babel/preset-typescript": "^7.21.4",
    "@commitlint/cli": "^17.5.1",
    "@commitlint/config-conventional": "^17.4.4",
    "@commitlint/config-lerna-scopes": "^17.4.2",
    "@rollup/plugin-babel": "^6.0.3",
    "@rollup/plugin-commonjs": "^24.0.1",
    "@rollup/plugin-eslint": "^9.0.3",
    "@rollup/plugin-json": "^6.0.0",
    "@rollup/plugin-node-resolve": "^15.0.1",
    "@rollup/plugin-terser": "^0.4.0",
    "@types/jest": "^29.5.0",
    "@types/react": "^18.0.31",
    "@types/react-dom": "^18.0.11",
    "@types/react-test-renderer": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^5.57.0",
    "@typescript-eslint/parser": "^5.57.0",
    "babel-loader": "^9.1.2",
    "babel-plugin-styled-components": "^2.0.7",
    "clean-webpack-plugin": "*",
    "core-js": "^3.29.1",
    "cross-fetch": "^3.1.5",
    "cspell": "^6.31.1",
    "css-loader": "^6.7.3",
    "css-minimizer-webpack-plugin": "^5.0.0",
    "eslint": "^8.37.0",
