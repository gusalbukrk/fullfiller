{
  "name": "@fullfiller/monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=14.0.0",
    "yarn": "use `npm` instead",
    "pnpm": "use `npm` instead"
  },
  "scripts": {
    "build": "lerna run --no-bail build",
    "clean:bootstrap": "rimraf node_modules/ packages/*/node_modules/",
    "clean:build": "rimraf packages/*/dist",
    "create": "node templates/create.js",
    "cspell": "cspell \"{**,**/.*,**/.*/**}\" -c cspell.config.cjs --no-progress",
    "lint": "npm run cspell && npm run lint:config && prettier **/*.{html,md,json} --write --loglevel warn && npm run lint:src",
    "lint:config": "eslint . --fix --ext .js,.cjs,.json --ignore-pattern '!.*' --ignore-pattern 'src/' --rule 'jest/unbound-method: off'",
    "lint:src": "lerna run --no-bail lint",
    "prepare": "husky install",
    "test": "lerna run --no-bail test"
  },
  "devDependencies": {
    "@babel/core": "^7.22.9",
    "@babel/eslint-parser": "^7.22.9",
    "@babel/preset-env": "^7.22.9",
    "@babel/preset-react": "^7.22.5",
    "@babel/preset-typescript": "^7.22.5",
    "@commitlint/cli": "^17.6.7",
    "@commitlint/config-conventional": "^17.6.7",
    "@commitlint/config-lerna-scopes": "^17.6.6",
    "@rollup/plugin-babel": "^6.0.3",
    "@rollup/plugin-commonjs": "^25.0.3",
    "@rollup/plugin-eslint": "^9.0.4",
    "@rollup/plugin-json": "^6.0.0",
    "@rollup/plugin-node-resolve": "^15.1.0",
    "@rollup/plugin-terser": "^0.4.3",
    "@types/cacache": "^15.0.1",
    "@types/find-cache-dir": "^3.2.1",
    "@types/jest": "^29.5.3",
    "@types/react": "^18.2.18",
    "@types/react-dom": "^18.2.7",
    "@types/react-test-renderer": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^6.2.1",
    "@typescript-eslint/parser": "^6.2.1",
    "babel-loader": "^9.1.3",
    "babel-plugin-styled-components": "^2.1.4",
    "clean-webpack-plugin": "*",
