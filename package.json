    "tslib": "^2.6.2",
    "typescript": "^5.3.3",
    "typescript-plugin-css-modules": "^5.0.2",
    "vite": "^5.0.8",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-stylelint": "^5.3.1"
  },
  "dependencies": {
    "api": "file:packages/api",
    "cli": "file:packages/cli",
    "fullfiller": "file:packages/fullfiller",
