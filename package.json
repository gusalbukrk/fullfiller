{
  "name": "@fullfiller/monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=14.0.0",
    "yarn": "use `npm` instead",
    "pnpm": "use `npm` instead"
  },
  "scripts": {
    "build": "lerna run build",
    "clean:bootstrap": "rimraf node_modules/ packages/*/node_modules/",
    "clean:build": "rimraf packages/*/dist",
    "create": "node templates/create.js",
    "cspell": "cspell \"{**,**/.*,**/.*/**}\" -c cspell.config.cjs --no-progress",
    "lint": "npm run cspell && npm run lint:config && prettier **/*.{md,json} --write --loglevel warn && npm run lint:src",
    "lint:config": "eslint . --fix --ext .js,.cjs,.json --ignore-pattern '!.*' --ignore-pattern 'src/' --rule 'jest/unbound-method: off'",
    "lint:src": "lerna run lint",
    "prepare": "husky install",
    "test": "lerna run test"
  },
  "devDependencies": {
    "@babel/core": "^7.19.6",
    "@babel/eslint-parser": "^7.19.1",
    "@babel/preset-env": "^7.19.4",
