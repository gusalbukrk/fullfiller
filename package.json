    "@types/react-dom": "^18.0.7",
    "@types/react-test-renderer": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^5.41.0",
    "@typescript-eslint/parser": "^5.41.0",
    "babel-loader": "^9.0.1",
    "babel-plugin-styled-components": "^2.0.7",
    "clean-webpack-plugin": "*",
    "core-js": "^3.26.0",
    "cross-fetch": "^3.1.5",
    "cspell": "^6.12.0",
